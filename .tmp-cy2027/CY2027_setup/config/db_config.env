# UAT database details used by setup_cy2027.py.
# Fill in DB_USER and DB_PASSWORD, save, then run: python setup_cy2027.py
# Write values exactly as they are - no quotes, no spaces around "=".

DB_HOST=10.165.55.34
DB_PORT=7001
DB_NAME=amns_gama_uat
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer

# Optional: folder that contains backend and frontend. Leave empty to auto-detect.
PROJECT_ROOT=

# Optional: Python of the backend virtual environment, e.g. /u01/env/bin/python
# Leave empty to use backend/venv inside the project.
PYTHON_PATH=

# Optional: full path to the base seed amns_uat_seed.zip. Leave empty if it is
# in CY2027_setup/base_seed/ (used only to re-create missing transporter routes).
BASE_SEED_FILE=
